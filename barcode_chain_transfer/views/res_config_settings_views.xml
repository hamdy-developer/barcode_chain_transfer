<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_barcode_chain" model="ir.ui.view">
        <field name="name">res.config.settings.form.barcode.chain</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="25"/>
        <field name="inherit_id" ref="stock.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <!-- Add Approve Chain Transfers setting under the operations settings -->
            <xpath expr="//div[@name='operations_setting_container']" position="inside">
                <div class="col-12 col-lg-6 o_setting_box" id="approve_chain_transfer_settings">
                    <div class="o_setting_left_pane">
                        <field name="approve_chain_by_manager"/>
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="approve_chain_by_manager"/>
                        <div class="text-muted">
                            Require inventory manager approval before validating chain transfers.
                        </div>
                    </div>
                </div>
                <div class="col-12 col-lg-6 o_setting_box" id="default_chain_transit_location_settings">
                    <div class="o_setting_left_pane"/>
                    <div class="o_setting_right_pane">
                        <label for="company_chain_transit_location_id"/>
                        <div class="text-muted">
                            Default transit location pre-filled in Barcode Chain Transfer dialog.
                        </div>
                        <div class="content-group">
                            <div class="mt16">
                                <field name="company_chain_transit_location_id" class="o_light_label" options="{'no_create': True}"/>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
